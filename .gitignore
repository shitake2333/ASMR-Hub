xcuserdata/

# Native binaries fetched at build time — keep only sources.
# The bridge C source, README and the FFmpeg 7.1 headers (third_party/ffmpeg/
# include/) are tracked: the headers are needed to compile the bridge on every
# platform (Windows/Android CMake, Linux/macOS pkg-config) and are small
# (~1 MB). DLLs / .so / .dylib binaries are downloaded or compiled by the
# build scripts (tool/*) and never committed.
third_party/ffmpeg/*.dll
third_party/ffmpeg/*.dll.a
third_party/ffmpeg/*.lib
third_party/ffmpeg/*.a
third_party/ffmpeg/*.so
third_party/ffmpeg/*.dylib
third_party/ffmpeg/ffmpeg_bridge.dll.bak

# Prebuilt FFmpeg for Android (built by tool/build_ffmpeg_android.sh).
android/app/src/main/jniLibs/

# Local scratch
0
*.log.*
.review/
